# Copy to .env next to the bot (or set these in the environment).

# The bot's token, from the Discord developer portal. The bot needs the Message
# Content intent turned on there, and in the server: Send Messages in the gather
# channel and permission to DM its members.
GATHER_DISCORD_TOKEN=
# The one channel the bot listens and talks in (right-click the channel > Copy ID,
# with Developer Mode on).
GATHER_CHANNEL_ID=
# The game servers: name=host:port, space-separated. The name is what each server's
# script says (its GATHER_SERVER_NAME), the host:port what players are told to join.
GATHER_SERVERS=eu1=gather.example.org:23073
# Shared with script/gather.lua, which sends it with every request.
GATHER_SECRET=change-me

# Where the HTTP API listens; the script's bot_url points here.
GATHER_LISTEN=:8080
# The command prefix.
GATHER_PREFIX=!beta_
# The map pool, space-separated. Empty: SoldatReloaded's CTF maps.
GATHER_MAPS=
# Players a side; 3 for 3v3.
GATHER_TEAM_SIZE=3
